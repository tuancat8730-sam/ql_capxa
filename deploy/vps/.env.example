# Template only: scripts/deploy-vps.sh writes the real .env on the server with random secrets.
# PUBLIC_URL is the address people type in the browser (the server's IP, plain HTTP).
PUBLIC_URL=http://203.0.113.10
IMAGE_TAG=latest

POSTGRES_PASSWORD=generated
DATABASE_URL=postgresql+asyncpg://qlda:generated@db:5432/qlda
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=3
JWT_SECRET=generated
# no HTTPS on a bare IP: the browser would drop a Secure cookie
COOKIE_SECURE=false

STORAGE_BACKEND=s3
S3_BUCKET=qlda-documents
S3_ENDPOINT_URL=http://garage:3900
# presigned URLs go through Caddy on the same origin
S3_PUBLIC_ENDPOINT_URL=http://203.0.113.10
S3_ACCESS_KEY=GKgenerated
S3_SECRET_KEY=generated
AWS_REGION=ap-southeast-1
GARAGE_RPC_SECRET=generated

APP_BASE_URL=http://203.0.113.10
CORS_ORIGINS=http://203.0.113.10
APP_TIMEZONE=Asia/Ho_Chi_Minh
ALERT_RUN_HOURS=6,13
AI_PROVIDER=none
MAIL_BACKEND=memory
ALERT_REFRESH_ON_WRITE=true
SEED_ADMIN_EMAIL=admin@qlda.local
