# Local development only. Never put real secrets here.
DATABASE_URL=postgresql+asyncpg://qlda:qlda@db:5432/qlda
JWT_SECRET=dev-only-change-me
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
S3_BUCKET=qlda-documents
S3_ENDPOINT_URL=http://minio:9000
# Address the browser uses for presigned URLs (MinIO is "minio:9000" only inside Docker)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-southeast-1
SES_SENDER=no-reply@qlda.local
SMTP_HOST=mailpit
SMTP_PORT=1025
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
ALERT_RUN_HOURS=6,13
AI_PROVIDER=none
